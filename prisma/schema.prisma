// Schéma CV Pro. Le contenu d'un CV est un JSON validé par Zod (src/lib/resume/schema.ts).

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooler, port 6543, ?pgbouncer=true
  directUrl = env("DIRECT_URL") // connexion directe, migrations uniquement
}

// Connexion sans mot de passe : un code à 6 chiffres envoyé par e-mail à chaque
// connexion. Le compte est créé à la première connexion réussie.
model User {
  id               String        @id @default(cuid())
  email            String        @unique
  name             String? // nom complet saisi à l'inscription (ou fourni par Google)
  emailVerifiedAt  DateTime?
  locale           String        @default("fr")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  resumes          Resume[]
  entitlements     Entitlement[]
  stripeCustomerId String?       @unique
}

// Code de connexion (valable 15 minutes, 5 essais, stocké haché, usage unique).
// `purpose` : "connexion" ou "inscription" ; `name` : nom saisi à l'inscription,
// gardé le temps de la vérification puis recopié sur le compte.
model EmailCode {
  id        String    @id @default(cuid())
  email     String
  purpose   String    @default("connexion")
  name      String?
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}

model Resume {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  cvLocale      String   @default("fr") // fr | en | pt
  templateId    String
  theme         Json
  content       Json
  schemaVersion Int      @default(1)
  photo         String? // photo recadrée (data URL JPEG 480 px, environ 50 Ko), supprimée avec le CV
  photoKey      String? // réservé : chemin dans un bucket privé si les photos y passent un jour
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

enum EntitlementKind {
  PASS_30J
  PASS_1AN
}

// Pass à paiement unique, sans renouvellement.
model Entitlement {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind            EntitlementKind
  stripeSessionId String          @unique
  startsAt        DateTime
  endsAt          DateTime
  createdAt       DateTime        @default(now())

  @@index([userId, endsAt])
}

// Idempotence du webhook Stripe.
model StripeEvent {
  id          String   @id
  processedAt DateTime @default(now())
}

// Limitation de débit (fenêtre fixe), clé du type "pdf:ip:<hash>".
model RateLimit {
  key         String   @id
  windowStart DateTime
  count       Int
}
